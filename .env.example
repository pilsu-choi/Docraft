# Copy to .env for local development.
# PostgreSQL runs via docker compose; uploaded files stay under DOCRAFT_DATA_DIR.
DATABASE_URL=postgresql://docraft:docraft@127.0.0.1:5433/docraft
DOCRAFT_DATA_DIR=./data
MAX_UPLOAD_BYTES=26214400
DOCRAFT_API_KEY=
# Backend logging. LOG_FILE defaults to <repo>/docraft.log; set it empty for stderr only.
LOG_LEVEL=DEBUG
# LOG_FILE=
# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Provider-backed schema generation and extraction.
AI_MODE=provider
AI_BASE_URL=
AI_API_KEY=
AI_VLM_MODEL=qwen/qwen3-vl-32b-instruct
# Set AI_MODE=local explicitly only for offline development/test heuristics.

# PaddleOCR-VL full layout pipeline. Local GPU: `docker compose --profile ocr up -d`,
# then PARSE_PROVIDER=paddle and PADDLEOCR_BASE_URL=http://127.0.0.1:8080.
PARSE_PROVIDER=library
PADDLEOCR_BASE_URL=
PADDLEOCR_ACCESS_TOKEN=
# Also selects the model served by the compose `ocr` profile.
PADDLEOCR_MODEL=PaddleOCR-VL-1.6-0.9B
PADDLEOCR_TIMEOUT=600
# 줄 단위 좌표용 PP-OCRv5 파이프라인(선택). 설정하면 근거 상자가 블록 대신 줄 단위가 된다.
# compose `ocr` profile 기준 http://127.0.0.1:8081, 비워 두면 기존 블록 단위 동작.
PADDLEOCR_LINES_URL=

# Job queue for parse/extract. inline = in-process thread pool (default, no extra deps).
# celery = send to a broker; install requirements-queue.txt and run `python -m backend.worker`.
# To reuse shared infra, point CELERY_BROKER_URL at the existing redis/RabbitMQ; QUEUE_NAME
# namespaces the queue, task names (<QUEUE_NAME>.parse) and redis keys (<QUEUE_NAME>:*).
QUEUE_BACKEND=inline
QUEUE_NAME=docraft
QUEUE_CONCURRENCY=2
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
