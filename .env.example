# Copy to .env for local development.
# The MVP stores SQLite and uploaded files under this directory.
DOCRAFT_DATA_DIR=./data
MAX_UPLOAD_BYTES=26214400
DOCRAFT_API_KEY=
# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional provider. The local parser remains available without a key.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
