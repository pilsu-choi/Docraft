# Docraft · AWS 개발 서버 설정
# 사용: cp deploy/aws/.env.aws.example deploy/aws/.env.aws 후 값을 채운다(.env.aws는 커밋되지 않는다).
# 이 파일은 서버에 .env로 올라가 compose 변수와 backend 환경변수로 함께 쓰인다.

# --- 접속 대상 (harness-v2 개발 서버와 같은 EC2) ---------------------------------
SSH_HOST=ec2-15-165-29-178.ap-northeast-2.compute.amazonaws.com
SSH_USER=ec2-user
# 절대경로 또는 저장소 기준 상대경로. 키 파일은 저장소에 두지 않는다.
SSH_KEY=~/.ssh/harness-dev.pem
# 루트 디스크(8.8GB)가 작아 데이터 디스크에 둔다. 업로드 파일(data/)도 여기 쌓인다.
REMOTE_ROOT=/mnt/data/docraft

# --- 포트 ------------------------------------------------------------------------
# 서버에는 frontend(nginx, /api를 backend로 프록시) 하나만 루프백에 연다.
# postgres·backend·PaddleOCR는 호스트 포트를 열지 않는다(harness가 5433 등을 쓴다).
FRONTEND_PORT=3000
# frontend를 어느 주소에 바인딩할지.
#   127.0.0.1 = 루프백 전용. 접근은 tunnel.sh의 SSH 터널로만 (기본·권장)
#   0.0.0.0   = 외부 노출. 보안그룹에서 FRONTEND_PORT를 열어야 접속된다.
# ⚠️ TLS가 없어 API 키와 업로드 문서(개인정보)가 평문으로 오간다. 0.0.0.0이면 DOCRAFT_API_KEY를 반드시 채우고
#    보안그룹 소스 IP를 사내 대역으로 제한하십시오.
FRONTEND_BIND=127.0.0.1
# tunnel.sh가 여는 로컬 포트. 로컬 스택(5173/3000)과 harness 터널(18080 등)과 겹치지 않게 잡았다.
TUNNEL_PORT=13000

# --- PaddleOCR -------------------------------------------------------------------
PARSE_PROVIDER=paddle
PADDLEOCR_MODEL=PaddleOCR-VL-1.6-0.9B
PADDLEOCR_IMAGE_TAG=latest-nvidia-gpu-offline
PADDLEOCR_GPU=0
PADDLEOCR_TIMEOUT=600

# --- 앱 --------------------------------------------------------------------------
# 비워 두면 인증 없이 열린다. 터널로만 접근하는 전제지만 채우는 것을 권장한다(openssl rand -hex 32).
DOCRAFT_API_KEY=
CORS_ORIGINS=http://localhost:13000
LOG_LEVEL=INFO
AI_MODE=provider
AI_BASE_URL=
AI_API_KEY=
AI_VLM_MODEL=qwen/qwen3-vl-32b-instruct
AI_REASONING=off
AI_VISION=true
TABLE_REFINE=false
QUEUE_BACKEND=inline
# 동시에 처리할 문서 수. PaddleOCR 레이아웃이 분당 약 12건에서 포화되는데, 문서마다 줄 OCR·표 교정(OpenRouter) 대기가
# 붙어 2로는 절반만 쓴다. 이미지 100건 실측: 2 → 6.5건/분, 6 → 10.6건/분(wiki/2026-09-22-aws-throughput.md).
QUEUE_CONCURRENCY=6
# /api/read·/api/verify 요청 시한(ms). 하네스가 300초까지 기다리므로 그보다 조금 짧게 잡아 408이 하네스 시한 전에 나게 한다.
# READ_MAX_MS=280000
# 같은 페이지의 필드·표 요청이 OCR·표 교정을 한 번만 하게 결과를 잠시 나눠 쓴다(0이면 끔).
# READ_CACHE_SIZE=8
# READ_CACHE_TTL_S=180
# PaddleOCR 레이아웃(L4)은 동시 2건에서 포화된다. 넘는 호출은 줄을 서고, 시한까지 자리가 안 나면 408.
# OCR_CONCURRENCY=2
# 표 교정 동시 호출 수와 한 호출의 최대 칸 수(큰 표는 행 묶음으로 나눠 병렬 호출).
# REFINE_CONCURRENCY=4
# REFINE_MAX_CELLS=300
# 재처리 루프: 남은 시간이 이보다 적으면 원격 OCR·VLM 단계를 새로 시작하지 않는다.
# REPROCESS_MIN_STAGE_MS=30000

# --- KCD/EDI 마스터(backend/master.py) --------------------------------------------
# 같은 EC2에서 harness-v2가 떠 있으면 그 Postgres를 읽기전용 재사용한다(원본 재적재 불필요).
# 예: postgresql://<user>:<pw>@127.0.0.1:<harness postgres 포트>/mlife_harness
HARNESS_DATABASE_URL=
# 위가 비었고 docraft DB에도 없을 때만 원본에서 적재한다. 서버 경로를 MASTER_SOURCE_HOST_DIR로 마운트한다.
# MASTER_SOURCE_DIR=/master
# MASTER_SOURCE_HOST_DIR=/mnt/data/master-source
